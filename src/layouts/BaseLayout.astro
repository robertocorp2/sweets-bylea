---
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/great-vibes/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { media, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  locale?: 'en' | 'es';
  alternatePath?: string;
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
  ogImage = `${site.siteUrl}/og.png`,
  locale = 'en',
  alternatePath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const englishPath = alternatePath.startsWith('/es') ? alternatePath.replace(/^\/es/, '') || '/' : alternatePath;
const spanishPath = englishPath === '/' ? '/es/' : `/es${englishPath}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href={site.logo} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fdfbf7" />
    <link rel="alternate" hreflang="en" href={`${site.siteUrl}${englishPath}`} />
    <link rel="alternate" hreflang="es" href={`${site.siteUrl}${spanishPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site.siteUrl}${englishPath}`} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
