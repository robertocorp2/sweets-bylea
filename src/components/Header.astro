---
import Icon from './Icon.astro';
import { locales, nav, site } from '../data/site';

const path = Astro.url.pathname;
const locale = path.startsWith('/es') ? 'es' : 'en';
const basePath = locale === 'es' ? path.replace(/^\/es/, '') || '/' : path;
const switchHref = locale === 'es' ? basePath : basePath === '/' ? '/es/' : `/es${basePath}`;
const isActive = (href) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href={locale === 'es' ? '/es/' : '/'} class="brand" aria-label={`${site.name} home`}>
      <span class="brand-mark"><img src={site.logo} alt="" /></span>
      <span class="brand-text">
        <span class="brand-script">SweetsByLea</span>
        <span class="brand-sub">{locale === 'es' ? 'Dulces con fe' : 'Sweets with faith'}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-links">
        {
          nav[locale].map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-cta">
      <a href={locale === 'es' ? '/es/contact/' : '/contact/'} class="btn btn-primary">{locale === 'es' ? 'Pedir ahora' : 'Order now'}</a>
      <a class="locale-switch" href={switchHref} aria-label={`Read in ${locales[locale === 'es' ? 'en' : 'es'].label}`}>
        {locales[locale === 'es' ? 'en' : 'es'].short}
      </a>
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button class="close" id="mobile-close" aria-label="Close menu">
    <Icon name="close" />
  </button>
  <nav aria-label="Mobile">
    <ul>
      {
        nav[locale].map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href)}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-cta">
    <a href={locale === 'es' ? '/es/contact/' : '/contact/'} class="btn btn-primary">{locale === 'es' ? 'Pedir ahora' : 'Order now'}</a>
    <a href={switchHref} class="btn btn-secondary">{locale === 'es' ? 'English' : 'Español'}</a>
  </div>
</div>
