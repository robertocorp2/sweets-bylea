---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href) => (path === href ? 'page' : undefined);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <span class="brand-mark"><span class="script" aria-hidden="true">L</span></span>
      <span class="brand-text">
        <span class="brand-script">Leanna Corporan</span>
        <span class="brand-sub">Bakehouse</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-cta">
      <a href="/contact/" class="btn btn-primary">Order Now</a>
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button class="close" id="mobile-close" aria-label="Close menu">
    <Icon name="close" />
  </button>
  <nav aria-label="Mobile">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href)}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-cta">
    <a href="/contact/" class="btn btn-primary">Order Now</a>
    <a href="/menu/" class="btn btn-secondary">View the menu</a>
  </div>
</div>
