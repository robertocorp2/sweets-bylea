---
import Icon from './Icon.astro';
import { copy, nav, site } from '../data/site';

const locale = Astro.url.pathname.startsWith('/es') ? 'es' : 'en';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={locale === 'es' ? '/es/' : '/'} class="brand">
          <span class="brand-mark"><img src={site.logo} alt="" /></span>
          <span class="brand-text">
            <span class="brand-script">SweetsByLea</span>
            <span class="brand-sub">{locale === 'es' ? 'Dulces con fe' : 'Sweets with faith'}</span>
          </span>
        </a>
        <p>{copy[locale].footerLine}</p>
        <div class="social-row">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
          <a href={site.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
            <Icon name="phone" />
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {nav[locale].map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{locale === 'es' ? 'Contacto' : 'Get in touch'}</h4>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phoneDisplay}</a></li>
          <li><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{locale === 'es' ? 'Pedidos' : 'Ordering'}</h4>
        <ul>
          <li>{locale === 'es' ? 'Cuéntame tu idea por WhatsApp.' : 'Tell Lea your idea on WhatsApp.'}</li>
          <li>{locale === 'es' ? 'Cada pedido se prepara con cuidado.' : 'Every order is prepared with care.'}</li>
          <li>{locale === 'es' ? 'Pedidos personalizados para tus momentos especiales.' : 'Custom orders for your special moments.'}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</span>
      <span>{locale === 'es' ? 'Hecho a mano con amor, horneado por Lea.' : 'Handcrafted with love, baked by Lea.'}</span>
    </div>
  </div>
</footer>
