---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { bestSellers, media, site, testimonials, galleryItems } from '../data/site';

const marqueeItems = [
  'Custom cakes',
  'Cupcakes',
  'Cookies',
  'Cake pops',
  'Weddings',
  'Birthdays',
  'Holiday specials',
];

const instaPosts = galleryItems.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: site.name,
  description: site.metaDescription,
  url: Astro.site,
  image: media.hero,
  telephone: site.phone,
  email: site.email,
  priceRange: '$$',
  servesCuisine: ['Bakery', 'Dessert'],
  sameAs: [site.instagram],
};
---

<BaseLayout>
  <!-- hero -->
  <section class="hero">
    <div class="hero-media">
      <img src={media.hero} alt={media.heroAlt} fetchpriority="high" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow">Handcrafted in small batches</span>
        <h1 class="hero-title">
          Handcrafted with <span class="script">love.</span><br />
          Baked by Leanna.
        </h1>
        <p class="hero-sub">
          Custom cakes, cupcakes, cookies, and cake pops made from real butter and
          Belgian chocolate for your most treasured celebrations.
        </p>
        <div class="hero-cta">
          <a href="/contact/" class="btn btn-primary">Order Now</a>
          <a href="/menu/" class="btn btn-secondary">View the menu</a>
        </div>
      </div>
    </div>
  </section>

  <!-- marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </div>

  <!-- story -->
  <section class="section">
    <div class="container story-grid">
      <div class="story-media reveal">
        <img src={media.story} alt={media.storyAlt} loading="lazy" />
      </div>
      <div class="story-body reveal">
        <span class="eyebrow">Meet Leanna</span>
        <h2>Baking is how I say <span class="script">I love you.</span></h2>
        <p>
          Leanna bakes the way her grandmother taught her: slowly, from scratch, with
          real ingredients.
        </p>
        <p>
          Every cupcake, cookie, and cake is made to order in small batches, never from
          a box.
        </p>
        <p>
          What began as a pandemic hobby is now the neighborhood's go-to for bespoke
          desserts.
        </p>
        <div class="story-meta">
          <Icon name="leaf" size={20} />
          Real butter, organic eggs, and Belgian chocolate. Always.
        </div>
        <a href="/about/" class="btn-arrow">
          More about Leanna <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- best sellers -->
  <section class="section best-sellers">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Most loved</span>
        <h2>The best sellers</h2>
      </div>
      <div class="best-sellers-grid">
        {
          bestSellers.map((item) => (
            <article class="product-card reveal">
              <div class="product-media">
                <img src={item.image} alt={item.alt} loading="lazy" />
              </div>
              <div class="product-info">
                <h3>{item.name}</h3>
                <p>{item.description}</p>
                <div class="product-row">
                  <span class="price">{item.price}</span>
                  <a href="/menu/" class="btn-arrow">
                    View flavors <Icon name="arrow-right" size={18} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- testimonials -->
  <section class="section testimonials">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Kind words</span>
        <h2>Loved by our customers</h2>
      </div>
      <div class="carousel reveal" id="testimonial-carousel">
        <div class="carousel-track">
          {
            testimonials.map((t, i) => (
              <figure class={`testimonial-slide${i === 0 ? ' is-active' : ''}`}>
                <span class="stars" aria-label="5 out of 5 stars">
                  {[0, 1, 2, 3, 4].map((n) => <Icon name="star" size={18} />)}
                </span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <cite>
                    <span class="name">{t.name}</span>
                    <span class="context">{t.context}</span>
                  </cite>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="carousel-dots" role="tablist" aria-label="Testimonials">
          {
            testimonials.map((t, i) => (
              <button
                type="button"
                role="tab"
                aria-label={`Testimonial ${i + 1}`}
                class={i === 0 ? 'is-active' : ''}
                data-index={i}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- instagram -->
  <section class="section-tight">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Follow along</span>
        <h2>Fresh from the bakehouse</h2>
        <p class="lede" style="margin-inline:auto;text-align:center;">
          See the latest bakes, behind-the-scenes moments, and flavor drops on Instagram.
        </p>
      </div>
      <div class="insta-grid">
        {
          instaPosts.map((post, i) => (
            <a class="insta-item" href={site.instagram} target="_blank" rel="noopener" aria-label="View on Instagram">
              <img src={post.image} alt={post.alt} loading="lazy" />
              <span class="insta-icon"><Icon name="instagram" size={28} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- cta -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-banner reveal">
        <span class="script" style="font-size: 2rem;">Craving something custom?</span>
        <h2>Let's bake your next celebration</h2>
        <p>
          Tell us your vision and we will turn it into a dessert your guests remember.
        </p>
        <a href="/contact/" class="btn btn-primary">Order Now</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
