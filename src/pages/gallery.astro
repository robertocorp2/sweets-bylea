---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, galleryFilters, galleryItems, site } from '../data/site';

const t = copy.en;
const filters = galleryFilters.en;
---

<BaseLayout locale="en" alternatePath="/gallery/" title={`Gallery | ${site.name}`} description="Browse real SweetsByLea cakes, cupcakes, strawberries, and baking videos.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Portfolio</span><h1>The Gallery</h1><p>Real creations from SweetsByLea, made for celebrations, gifting, and sharing joy.</p></div></section>
  <section class="section-tight"><div class="container"><div class="gallery-filter" role="tablist" aria-label="Filter gallery">{filters.map((filter, index) => <button type="button" role="tab" class={`filter-tab${index === 0 ? ' is-active' : ''}`} data-filter={filter.id} aria-selected={index === 0 ? 'true' : 'false'}>{filter.label}</button>)}</div><div class="masonry" id="gallery-grid">{galleryItems.map((item) => <figure class="masonry-item" data-category={item.category}>{item.kind === 'video' ? <video src={item.image} poster={item.poster} controls preload="metadata" aria-label={item.alt}></video> : <img src={item.image} alt={item.alt} loading="lazy" />}</figure>)}</div></div></section>
  <section class="section-tight"><div class="container"><div class="cta-banner reveal"><span class="script" style="font-size: 2rem;">{t.ctaEyebrow}</span><h2>{t.ctaTitle}</h2><p>{t.ctaBody}</p><a href="/contact/" class="btn btn-primary">{t.contactLink}</a></div></div></section>
</BaseLayout>
