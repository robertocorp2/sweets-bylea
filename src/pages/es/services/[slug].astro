---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { services, site } from '../../../data/site';

export function getStaticPaths() {
  return services.es.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Service', name: service.title, description: service.summary, provider: { '@type': 'Bakery', name: site.name } };
---

<BaseLayout locale="es" alternatePath={`/es/services/${service.slug}/`} title={`${service.title} | ${site.name}`} description={service.summary} ogImage={`${site.siteUrl}${service.image}`}>
  <section class="page-hero"><div class="container"><span class="eyebrow">{service.cardTitle}</span><h1>{service.title}</h1><p>{service.summary}</p></div></section>
  <section class="section"><div class="container about-grid"><div class="media reveal"><img src={service.image} alt={service.alt} /></div><div class="about-copy reveal"><span class="eyebrow">Una forma más personal de celebrar</span><h2>Hecho con intención para tu momento.</h2>{service.body.map((paragraph) => <p>{paragraph}</p>)}<a href={`/es/contact/?service=${encodeURIComponent(service.title)}`} class="btn btn-primary">Comenzar a planear <Icon name="arrow-right" size={18} /></a></div></div></section>
  <section class="section ingredients"><div class="container"><div class="section-head"><span class="eyebrow">Ideal para</span><h2>Hecho para celebraciones especiales.</h2></div><div class="ingredients-grid">{service.idealFor.map((item) => <div class="ingredient-card reveal"><span class="ingredient-icon"><Icon name="heart" size={24} /></span><h3>{item}</h3><p>Detalles pensados y hechos con cuidado.</p></div>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Cómo funciona</span><h2>De la idea al dulce terminado.</h2></div><div class="process-grid service-steps">{service.steps.map((step, index) => <div class="process-step reveal"><span class="num">0{index + 1}</span><h3>{step}</h3><p>Lea te acompañará en cada detalle.</p></div>)}</div></div></section>
  <section class="section-tight"><div class="container"><div class="cta-banner reveal"><span class="script" style="font-size: 2rem;">Hagámoslo especial</span><h2>¿Lista para comenzar?</h2><p>Comparte tu visión y Lea te ayudará a elegir el siguiente paso más dulce.</p><a href={`/es/contact/?service=${encodeURIComponent(service.title)}`} class="btn btn-primary">Cuéntale a Lea</a></div></div></section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
