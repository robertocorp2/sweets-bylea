---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { contactCopy, site } from '../data/site';

const t = contactCopy.en;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Contact | ${site.name}` };
---

<BaseLayout locale="en" alternatePath="/contact/" title={`Contact | ${site.name}`} description="Start a SweetsByLea order or ask about custom cakes, cupcakes, event desserts, and consultations.">
  <section class="page-hero"><div class="container"><span class="eyebrow">{t.eyebrow}</span><h1>{t.title}</h1><p>{t.intro}</p></div></section>
  <section class="section-tight"><div class="container"><div class="contact-grid"><form class="form" id="contact-form" data-locale="en" data-whatsapp={site.whatsapp} novalidate><div class="form-grid"><div class="field"><label for="name">{t.name}</label><input id="name" name="name" type="text" autocomplete="name" required /><p class="error">{t.required}</p></div><div class="field"><label for="email">{t.email}</label><input id="email" name="email" type="email" autocomplete="email" required /><p class="error">{t.emailError}</p></div><div class="field"><label for="phone">{t.phone}</label><input id="phone" name="phone" type="tel" autocomplete="tel" /><p class="helper">{t.helper}</p></div><div class="field"><label for="event-date">{t.date}</label><input id="event-date" name="event-date" type="date" /><p class="helper">{t.dateHelper}</p></div></div><div class="field"><label for="message">{t.message}</label><textarea id="message" name="message" placeholder={t.messagePlaceholder} required></textarea><p class="error">{t.required}</p></div><button type="submit" class="btn btn-primary">{t.submit} <Icon name="arrow-right" size={18} /></button><p class="form-status" id="form-status" role="status"></p><p class="form-note">{t.whatsappNote}</p></form><aside class="contact-side"><div class="contact-card"><h3>{t.contactTitle}</h3><div class="contact-line"><span class="icon"><Icon name="mail" size={19} /></span><div><strong>{t.emailLabel}</strong><span><a href={`mailto:${site.email}`}>{site.email}</a></span></div></div><div class="contact-line"><span class="icon"><Icon name="phone" size={19} /></span><div><strong>{t.phoneLabel}</strong><span><a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneDisplay}</a></span></div></div><div class="contact-line"><span class="icon"><Icon name="instagram" size={19} /></span><div><strong>{t.instagramLabel}</strong><span><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></span></div></div></div><div class="contact-card"><h3>WhatsApp</h3><p class="lede">{t.whatsappNote}</p><a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-secondary">Open WhatsApp <Icon name="arrow-right" size={18} /></a></div></aside></div></div></section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
