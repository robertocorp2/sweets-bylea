# Copy this file to .env locally and fill in real values.
# Never commit .env.

# GitHub fine-grained personal access token (repo + contents + actions)
GITHUB_TOKEN=

# Cloudflare account API token (cfat_...) with Pages edit permission
CLOUDFLARE_API_TOKEN=

# Cloudflare account identifier
CLOUDFLARE_ACCOUNT_ID=

# Optional: Cloudflare R2 S3-compatible credentials (not required for the static site)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_REGION=auto
R2_BUCKET_NAME=
